# app.py — Streamlit app for housing quick-sale prediction

import pandas as pd
import streamlit as st
from pathlib import Path
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import roc_auc_score, classification_report

st.set_page_config(page_title="🏠 Will My Home Sell Quickly?", layout="centered")

# -----------------------------
# 1. Load data and train model
# -----------------------------

DATA_PATH = Path("housing_quick_sale.csv")  # <-- make sure this file is in your repo

FEATURES = ["size_sqft", "bedrooms", "bathrooms", "has_pool", "land_size_acres"]
TARGET = "sold_quickly"


@st.cache_resource
def train_model():
    if not DATA_PATH.exists():
        raise FileNotFoundError(
            f"Could not find {DATA_PATH}. "
            "Make sure housing_quick_sale.csv is in the same folder as app.py."
        )

    df = pd.read_csv(DATA_PATH)

    # Select features and target
    X = df[FEATURES].copy()
    y = df[TARGET].astype(int)

    # Train/test split
    X_tr, X_te, y_tr, y_te = train_test_split(
        X, y, test_size=0.25, random_state=42, stratify=y
    )

    # Logistic Regression model
    model = LogisticRegression(max_iter=1000, class_weight="balanced")
    model.fit(X_tr, y_tr)

    # Simple validation
    probs = model.predict_proba(X_te)[:, 1]
    auc = roc_auc_score(y_te, probs)
    report = classification_report(y_te, (probs >= 0.5).astype(int), output_dict=False)

    return model, auc, report


# Try to train / load the model
try:
    model, auc, report = train_model()
except Exception as e:
    st.error(f"Problem loading data or training model: {e}")
    st.stop()

# -----------------------------
# 2. App header / description
# -----------------------------

st.markdown(
    """
    <div style="background-color:yellow;padding:13px">
      <h1 style="color:black;text-align:center;">Predict How Fast Your Home Would Sell</h1>
    </div>
    """,
    unsafe_allow_html=True,
)

st.write(
    "Use the sliders and inputs below to estimate the probability that a home will "
    "sell quickly (e.g., within 30 days) based on its features."
)

with st.expander("Model performance (validation)"):
    st.write(f"**Validation ROC AUC:** `{auc:.3f}`")
    st.text("Classification Report:\n" + report)

# -----------------------------
# 3. User inputs
# -----------------------------

col1, col2 = st.columns(2)

with col1:
    size_sqft = st.number_input(
        "Home Size (sqft)", min_value=300, max_value=10000, value=2200, step=50
    )
    bedrooms = st.selectbox("Bedrooms", [1, 2, 3, 4, 5, 6], index=2)

with col2:
    bathrooms = st.selectbox(
        "Bathrooms", [1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0], index=2
    )
    has_pool_txt = st.radio("Pool?", ["No", "Yes"], index=0)

land_size_acres = st.number_input(
    "Land Size (acres)",
    min_value=0.01,
    max_value=5.0,
    value=0.20,
    step=0.01,
    format="%.2f",
)

# -----------------------------
# 4. Prediction
# -----------------------------

if st.button("Check"):
    # Build a DataFrame for the model
    row = pd.DataFrame(
        [
            {
                "size_sqft": int(size_sqft),
                "bedrooms": int(bedrooms),
                "bathrooms": float(bathrooms),
                "has_pool": 1 if has_pool_txt == "Yes" else 0,
                "land_size_acres": float(land_size_acres),
            }
        ]
    )[FEATURES]

    proba = float(model.predict_proba(row)[0, 1])
    label = (
        "Will Sell Quickly (≤ 30 days)" if proba >= 0.5 else "May Take Longer to Sell"
    )

    st.metric("Probability (Sell Quickly)", f"{proba:.2%}")
    if proba >= 0.5:
        st.success(f"Prediction: {label}")
    else:
        st.warning(f"Prediction: {label}")
